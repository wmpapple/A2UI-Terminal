{
  "name": "a2ui-terminal",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:a2ui-conformance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-a2ui-conformance.ps1",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:beta": "playwright test e2e/beta-acceptance.spec.ts",
    "test:beta:integration": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --test product_beta -- --test-threads=1 --nocapture",
    "test:beta:desktop": "node scripts/verify-product-beta-desktop.mjs",
    "test:search:integration": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --test persistent_search -- --test-threads=1 --nocapture",
    "test:search:desktop": "node scripts/verify-product-beta-desktop.mjs src-tauri/target/debug/a2ui-terminal.exe logs/m5a-desktop --persistent-search",
    "test:semantic:integration": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --test semantic_search -- --test-threads=1 --nocapture",
    "test:semantic:desktop": "node scripts/verify-product-beta-desktop.mjs src-tauri/target/debug/a2ui-terminal.exe logs/m5b-desktop --hybrid-search",
    "test:longform:integration": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --test writing_projects -- --test-threads=1 --nocapture",
    "test:longform:desktop": "node scripts/verify-product-beta-desktop.mjs src-tauri/target/debug/a2ui-terminal.exe logs/m6-desktop --longform",
    "test:critic:integration": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --test critic -- --test-threads=1 --nocapture",
    "test:critic:desktop": "node scripts/verify-product-beta-desktop.mjs src-tauri/target/debug/a2ui-terminal.exe logs/m7-desktop --critic",
    "audit:critic": "node scripts/verify-critic-evidence.mjs",
    "test:structured:integration": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --test structured_document -- --test-threads=1",
    "test:structured:desktop": "node scripts/verify-product-beta-desktop.mjs logs/m8-structured-review/a2ui-terminal.exe logs/m8-desktop --structured",
    "audit:structured": "node scripts/verify-structured-evidence.mjs",
    "test:scenes:integration": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --test scene_tools --test scene_bindings -- --test-threads=1",
    "test:scenes:desktop": "node scripts/verify-product-beta-desktop.mjs logs/m9-workbench-baseline-review/a2ui-terminal.exe logs/m9-workbench-baseline-desktop-verified --scenes",
    "audit:scenes": "node scripts/verify-scene-navigation-evidence.mjs",
    "eval:longform:server": "node scripts/longform-eval-server.mjs",
    "eval:longform": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --test writing_projects real_model_fixed_longform_eval -- --ignored --nocapture",
    "eval:longform:score": "node scripts/score-longform-eval.mjs",
    "audit:longform": "node scripts/verify-longform-evidence.mjs",
    "eval:retrieval:server": "node scripts/semantic-eval-server.mjs",
    "eval:retrieval": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --test semantic_search real_model_fixed_retrieval_eval -- --ignored --nocapture",
    "audit:hybrid-search": "node scripts/verify-hybrid-search-evidence.mjs",
    "test:e2e:install": "playwright install chromium",
    "audit:third-party": "node scripts/audit-third-party.mjs",
    "audit:beta-evidence": "node scripts/verify-beta-acceptance.mjs",
    "audit:product-beta": "node scripts/verify-product-beta-evidence.mjs",
    "audit:persistent-search": "node scripts/verify-persistent-search-evidence.mjs",
    "audit:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "eval:style:validate": "node evals/style/validate.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-dev.ps1",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "antd": "^6.3.6",
    "markdown-it": "^14.3.0",
    "md-editor-rt": "^6.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.0.4",
    "vitest": "^4.1.10"
  }
}
