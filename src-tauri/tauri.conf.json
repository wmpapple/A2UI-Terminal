{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A2UI 工作台",
  "version": "2.0.0",
  "identifier": "com.a2ui.terminal",
  "mainBinaryName": "a2ui-terminal",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "A2UI 工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "dragDropEnabled": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": ["main-capability"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "AI workspace with reviewable file patches",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "04082aee-f6fd-526d-9670-71abf0ca6863",
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "resources": [
      "assets/fonts/OFL.txt",
      "assets/fonts/NotoEmoji-OFL.txt",
      "assets/licenses/*",
      "THIRD_PARTY_NOTICES.md"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
